{
  "name": "php-toolbox",
  "displayName": "PHP Toolbox",
  "description": "Navigate and refactor PHP code: inherited symbols, usages grouped by intent, and workspace-wide rename or namespace move",
  "version": "0.1.0",
  "publisher": "farrugia",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "bun esbuild.ts",
    "watch": "bun esbuild.ts --watch",
    "check": "tsc -p . --noEmit",
    "vscode:prepublish": "bun run build",
    "test": "bun test"
  },
  "contributes": {
    "commands": [
      {
        "command": "phpToolbox.renameType",
        "title": "Rename class, interface or trait…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.inheritedSymbols",
        "title": "Go to Symbol (including inherited)",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.findUsages",
        "title": "Find usages",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.moveClass",
        "title": "Move class…",
        "category": "PHP"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "phpToolbox.renameType",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.moveClass",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.inheritedSymbols",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.findUsages",
          "when": "editorLangId == php"
        }
      ]
    },
    "keybindings": [
      {
        "command": "phpToolbox.renameType",
        "key": "shift+f6",
        "when": "editorLangId == php && editorTextFocus"
      },
      {
        "command": "phpToolbox.moveClass",
        "key": "ctrl+shift+f6",
        "when": "editorLangId == php && editorTextFocus"
      }
    ]
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "php-parser": "^3.7.0"
  }
}
