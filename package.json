{
  "name": "php-toolbox",
  "displayName": "PHP Toolbox",
  "description": "Navigate PHP code: inherited symbols, and usages of a class, interface or trait grouped by what the code does with it",
  "version": "0.1.0",
  "publisher": "farrugia",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "bun esbuild.ts",
    "watch": "bun esbuild.ts --watch",
    "check": "tsc -p . --noEmit",
    "vscode:prepublish": "bun run build"
  },
  "contributes": {
    "commands": [
      {
        "command": "phpToolbox.inheritedSymbols",
        "title": "Go to Symbol (including inherited)",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.findUsages",
        "title": "Find usages",
        "category": "PHP"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
