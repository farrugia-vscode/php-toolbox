{
  "name": "php-toolbox",
  "displayName": "PHP Toolbox",
  "description": "Navigate and refactor PHP code the way PhpStorm does: extract and inline, change signature, move members, inherited symbols, usages grouped by intent, workspace-wide rename",
  "version": "0.2.0",
  "publisher": "farrugia",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "bun esbuild.ts",
    "watch": "bun esbuild.ts --watch",
    "check": "tsc -p . --noEmit",
    "vscode:prepublish": "bun run build",
    "test": "bun test"
  },
  "contributes": {
    "configuration": {
      "title": "PHP Toolbox",
      "properties": {
        "phpToolbox.unusedMembers.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Grey out the private members no line of the file uses. Read from the file alone, so a member only reached in a way nothing can follow — a name built at runtime, a trait calling into the class — may be greyed out while still being used."
        }
      }
    },
    "commands": [
      {
        "command": "phpToolbox.rename",
        "title": "Rename…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.renameType",
        "title": "Rename class, interface or trait…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.renameLocal",
        "title": "Rename variable or parameter…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.inheritedSymbols",
        "title": "Go to Symbol (including inherited)",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.findUsages",
        "title": "Find usages",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.findMemberUsages",
        "title": "Find member usages",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.moveClass",
        "title": "Move class…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.copyClass",
        "title": "Copy class…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.extractMethod",
        "title": "Extract method…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.extractVariable",
        "title": "Extract variable…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.extractConstant",
        "title": "Extract constant…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.extractProperty",
        "title": "Extract property…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.inlineVariable",
        "title": "Inline variable",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.inlineMethod",
        "title": "Inline method",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.changeSignature",
        "title": "Change signature…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.introduceParameter",
        "title": "Introduce parameter…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.extractInterface",
        "title": "Extract interface…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.pullMemberUp",
        "title": "Pull member up…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.pushMemberDown",
        "title": "Push member down…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.showActions",
        "title": "Show refactorings…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.renameMember",
        "title": "Rename method, property or constant…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.implementMissing",
        "title": "Implement missing methods…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.generateConstructor",
        "title": "Generate constructor…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.safeDelete",
        "title": "Safe delete",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.findImplementations",
        "title": "Find implementations",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.moveMethod",
        "title": "Move method to another class…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.extractConstantToClass",
        "title": "Extract constant to another class…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.extractTrait",
        "title": "Extract trait…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.overrideMethod",
        "title": "Override method…",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.sortMembers",
        "title": "Sort members",
        "category": "PHP"
      },
      {
        "command": "phpToolbox.goToTest",
        "title": "Go to test",
        "category": "PHP"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "phpToolbox.rename",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.renameType",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.renameLocal",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.moveClass",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.copyClass",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.inheritedSymbols",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.findUsages",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.findMemberUsages",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.extractMethod",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.extractVariable",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.extractConstant",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.extractProperty",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.inlineVariable",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.inlineMethod",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.changeSignature",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.introduceParameter",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.extractInterface",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.extractTrait",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.overrideMethod",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.sortMembers",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.goToTest",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.pullMemberUp",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.pushMemberDown",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.renameMember",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.implementMissing",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.generateConstructor",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.safeDelete",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.findImplementations",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.moveMethod",
          "when": "editorLangId == php"
        },
        {
          "command": "phpToolbox.extractConstantToClass",
          "when": "editorLangId == php"
        }
      ],
      "explorer/context": [
        {
          "command": "phpToolbox.copyClass",
          "when": "resourceExtname == .php",
          "group": "7_modification@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "phpToolbox.rename",
        "key": "shift+f6",
        "when": "editorLangId == php && editorTextFocus"
      },
      {
        "command": "phpToolbox.moveClass",
        "key": "ctrl+shift+f6",
        "when": "editorLangId == php && editorTextFocus"
      },
      {
        "command": "phpToolbox.showActions",
        "key": "alt+enter",
        "when": "editorLangId == php && editorTextFocus && !editorReadonly && !suggestWidgetVisible"
      }
    ]
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "php-parser": "^3.7.0"
  }
}
