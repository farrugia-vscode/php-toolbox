{
  "name": "php-inherited-symbols",
  "displayName": "PHP Inherited Symbols",
  "description": "Go to symbol including members inherited from parent classes and traits",
  "version": "0.0.2",
  "publisher": "farrugia",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "bun esbuild.ts",
    "watch": "bun esbuild.ts --watch",
    "check": "tsc -p . --noEmit",
    "vscode:prepublish": "bun run build"
  },
  "contributes": {
    "commands": [
      {
        "command": "phpInheritedSymbols.show",
        "title": "PHP: Go to Symbol (incl. inherited)"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
